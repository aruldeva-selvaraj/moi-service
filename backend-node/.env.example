# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=moi_wedding_db
DB_SSL=false

# Server
PORT=3000
HOST=0.0.0.0

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:4200

# JWT
JWT_SECRET=moify_jwt_secret_change_in_prod
JWT_EXPIRES_IN=8h
