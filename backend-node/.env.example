# PostgreSQL connection (same database as Python backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=moi_wedding_db
DB_SSL=false

# Server — use 8001 so both backends can run simultaneously
PORT=8001
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200
